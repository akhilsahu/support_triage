# Copy to .env for local development. .env is gitignored — keep secrets out of git.
#
# VITE_API_URL — where the browser sends API calls.
#   Leave EMPTY in local dev: requests then use relative URLs and go through the
#   Vite dev proxy (see vite.config.ts), so they are same-origin and CORS is
#   never involved.
#   Setting an absolute host (e.g. http://127.0.0.1:8000) makes every call
#   cross-origin; some browsers/extensions silently stall requests to
#   127.0.0.1 from page context, which looks like the backend being down.
#   Production builds use .env.production instead.
VITE_API_URL=

# NOTE: only variables prefixed with VITE_ are exposed to browser code. Backend
# settings (DATABASE_URL, API keys, etc.) belong in the root .env, never here.
