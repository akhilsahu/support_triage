# ─────────────────────────────────────────────────────────────────
#  SUPPORT247.chat — Environment Variables
#  Copy to .env and fill in values marked with <...>
#  Never commit .env to git
#
#  GitHub Actions Secrets (set in repo Settings → Secrets):
#    VPS_HOST     → your VPS IP address
#    VPS_USER     → SSH username (root or ubuntu)
#    VPS_SSH_KEY  → contents of your private SSH key (~/.ssh/id_rsa)
#    GITHUB_TOKEN → auto-provided by Actions, no action needed
# ─────────────────────────────────────────────────────────────────

# GitHub Container Registry — used in docker-compose.prod.yml
# Format: your-github-username/bob-watson-hackathon
GITHUB_REPO=<your-github-username>/bob-watson-hackathon

# CORS — allow Netlify frontend
CORS_ORIGINS=["https://support247.chat","https://www.support247.chat","http://localhost:5173"]

# Application Configuration
APP_NAME=SUPPORT247.chat
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multiagent
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_DECODE_RESPONSES=true

# Security Configuration
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Ordered, comma-separated provider names. The first entry below with a
# configured API key becomes the PRIMARY provider for every LLM call; every
# OTHER configured provider after it becomes an automatic live-retry fallback
# -- a rate limit/timeout/5xx on the primary retries through the next one in
# this order, same request, no restart needed. (Auth errors — a bad/expired
# key — deliberately do NOT fall back; see LLMFactory.build_fallbacks().)
LLM_PROVIDER_PRIORITY=openai,openrouter,anthropic,watsonx
FACT_FINDER_MODEL=anthropic/claude-3.5-sonnet
FACT_VERIFIER_MODEL=openai/gpt-4o

# OpenRouter Configuration — proxies many providers' models behind one key.
# Model id format is "<provider>/<model>", not a bare OpenAI model id — see
# https://openrouter.ai/models (e.g. "openai/gpt-4o-mini", "anthropic/claude-3-haiku").
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Embeddings: which endpoint to reach the embedding model through.
# "openrouter" proxies to the SAME OpenAI model at the SAME dimensions, so
# switching is a drop-in — existing stored vectors stay valid, no re-embed.
# Leave EMBEDDING_MODEL as the bare OpenAI id either way; the "openai/" prefix
# OpenRouter needs is added automatically.
# NOTE: unlike the chat model, embeddings have NO automatic fallback — if this
# provider is down, knowledge-base search returns nothing (the bot still
# replies, just without citations).
EMBEDDING_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=2000

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# Agent max_tokens policy
# AGENT_MAX_TOKENS_OVERRIDE=true forces AGENT_MAX_TOKENS_LIMIT onto every agent,
# ignoring each agent's own max_tokens. When false (default), agents use their own
# value and fall back to AGENT_MAX_TOKENS_LIMIT only when they have none set.
AGENT_MAX_TOKENS_OVERRIDE=false
AGENT_MAX_TOKENS_LIMIT=2000

# RAG Configuration
RAG_TOP_K=8
RAG_SIMILARITY_THRESHOLD=0.7
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_MAX_CONTEXT_LENGTH=4000
# Table captions for retrieval: heuristic (free, default) | llm (1 call/table) | none
TABLE_CAPTION_MODE=heuristic

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000

# Monitoring & Metrics
ENABLE_METRICS=true
METRICS_PORT=9090
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=["txt","pdf","docx","md","json"]

# Logging
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days

# Agent Configuration
AGENT_TIMEOUT=300
AGENT_MAX_RETRIES=3
AGENT_RETRY_DELAY=5

# Workflow Configuration
WORKFLOW_MAX_STEPS=50
WORKFLOW_TIMEOUT=600
WORKFLOW_PARALLEL_WORKERS=5

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000
WS_MESSAGE_QUEUE_SIZE=100

# SMTP — password reset emails (leave blank to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-email@gmail.com>
SMTP_PASS=<your-app-password>
SMTP_FROM=noreply@support247.chat
PASSWORD_RESET_TTL_MINUTES=30

# URL preview providers. Quick Preview remains local/static; Deep Preview is
# disabled until FIRECRAWL_API_KEY is supplied.
SCRAPER_QUICK_PROVIDER=httpx
SCRAPER_DEEP_PROVIDER=firecrawl
SCRAPER_DEEP_TIMEOUT_S=15
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_MAX_REQUESTS_PER_SPACE_PER_DAY=50
FIRECRAWL_MAX_CONCURRENT_REQUESTS=2

# Modal Custom Model Deployment
MODAL_API_KEY=your_token_here
MODAL_BASE_URL=https://your-workspace--hierarchy-extractor-api-serve.modal.run/v1
